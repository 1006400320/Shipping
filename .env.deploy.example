# Copy this file to .env.deploy, then fill in the token.
# .env.deploy is ignored by git.
VERCEL_TOKEN=

# Vercel Edge Config connection string. Keep this server-side only.
# Local PowerShell:
#   $env:EDGE_CONFIG='https://edge-config.vercel.com/ecfg_xxx?token=xxx'
# Vercel dashboard:
#   Project Settings -> Environment Variables -> EDGE_CONFIG
EDGE_CONFIG=
